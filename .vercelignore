# Exclude the entire native Android project from web deployment
frontend/android/
**/android/**

# DO NOT EXCLUDE BACKEND - The Vercel Brain (api/index.js) depends on this folder.
# backend/

# Exclude build artifacts and caches
**/node_modules/**
**/dist/**
**/dist-ssr/**
**/.gradle/**
**/build/**
**/.vercel/**

# Exclude heavy binaries
*.apk
*.aab
*.jks
*.jar
*.flat

# Specific large files
**/ambient.mp3
!frontend/public/ambient.mp3
